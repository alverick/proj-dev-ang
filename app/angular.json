{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "EurekaAngularProy": {
      "root": "",
      "sourceRoot": "src",
      "projectType": "application",
      "prefix": "cs",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "allowedCommonJsDependencies": [
              "dompurify",
              "file-saver",
              "strip-ansi",
              "moment",
              "sweetalert2",
              "lodash",
              "exceljs",
              "react-dom",
              "dot-object"
            ],
            "outputPath": "dist/EurekaAngularProy",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "src/tsconfig.app.json",
            "assets": [
              "src/faviconIbk.ico",
              "src/assets",
              "src/mockServiceWorker.js"
            ],
            "styles": [
              "src/scss/layers.css",
              "node_modules/font-awesome/css/font-awesome.css",
              "node_modules/primeicons/primeicons.css",
              "node_modules/shepherd.js/dist/css/shepherd.css",
              "src/scss/style.scss"
            ],
            "scripts": ["libs/fingerprint.js"],
            "stylePreprocessorOptions": {
              "includePaths": ["src/scss", "node_modules"]
            }
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "outputPath": "dist/EurekaAngularProy-production",
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "aot": true,
              "extractLicenses": true
            },
            "legacy-production": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.legacy-prod.ts"
                }
              ],
              "outputPath": "dist/EurekaAngularProy-leg",
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "aot": true,
              "extractLicenses": true
            },
            "local": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.local.ts"
                }
              ],
              "outputPath": "dist/EurekaAngularProy-local"
            },
            "hmr": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.hmr.ts"
                }
              ],
              "outputPath": "dist/EurekaAngularProy-hmr",
              "optimization": false,
              "aot": true,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            },
            "uat": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.uat.ts"
                }
              ],
              "outputPath": "dist/EurekaAngularProy-uat",
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": true
              },
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "aot": true,
              "extractLicenses": true
            },
            "dev": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.dev.ts"
                }
              ],
              "outputPath": "dist/EurekaAngularProy-dev",
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": true,
              "namedChunks": false,
              "aot": true,
              "extractLicenses": true
            }
          }
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "development": {
              "buildTarget": "EurekaAngularProy:build"
            },
            "production": {
              "buildTarget": "EurekaAngularProy:build:production"
            },
            "hmr": {
              "buildTarget": "EurekaAngularProy:build:hmr",
              "hmr": true
            },
            "local": {
              "buildTarget": "EurekaAngularProy:build:local"
            },
            "dev": {
              "buildTarget": "EurekaAngularProy:build:dev"
            },
            "uat": {
              "buildTarget": "EurekaAngularProy:build:uat"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "EurekaAngularProy:build"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["src/**/*.ts", "src/**/*.html"]
          }
        },
        "storybook": {
          "builder": "@storybook/angular:start-storybook",
          "options": {
            "configDir": ".storybook",
            "browserTarget": "EurekaAngularProy:build",
            "compodoc": true,
            "compodocArgs": ["-e", "json", "-d", "."],
            "port": 6006
          }
        },
        "build-storybook": {
          "builder": "@storybook/angular:build-storybook",
          "options": {
            "configDir": ".storybook",
            "browserTarget": "EurekaAngularProy:build",
            "compodoc": true,
            "compodocArgs": ["-e", "json", "-d", "."],
            "outputDir": "dist/storybook/EurekaAngularProy"
          }
        }
      }
    },
    "EurekaAngularProy-e2e": {
      "root": "e2e/",
      "projectType": "application",
      "architect": {
        "e2e": {
          "builder": "@angular-devkit/build-angular:protractor",
          "options": {
            "protractorConfig": "e2e/protractor.conf.js",
            "devServerTarget": "EurekaAngularProy:serve"
          },
          "configurations": {
            "production": {
              "devServerTarget": "EurekaAngularProy:serve:production"
            }
          }
        }
      }
    }
  },
  "schematics": {
    "@schematics/angular:component": {
      "style": "scss",
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  },
  "cli": {
    "analytics": "92e6e9c2-fa2f-4a6c-a6a1-45b6adf701be",
    "schematicCollections": ["@ngrx/schematics", "@angular-eslint/schematics"]
  }
}
